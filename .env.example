# SAND environment variables (copy to .env and fill in as needed)

# Data & server
# SAND_DATA_DIR=.sand/data
# SAND_HOST=127.0.0.1
# SAND_PORT=8765

# LLM (optional — required for free-text Chat Ask)
# SAND_LLM_BASE_URL=https://api.openai.com/v1
# SAND_LLM_API_KEY=
# SAND_LLM_MODEL=gpt-4o-mini

# Resource limits
# SAND_MAX_INGEST_BYTES=209715200
# SAND_MAX_RESULT_ROWS=100000
# SAND_MAX_EXPORT_ROWS=500000
# SAND_MAX_MATERIALIZE_ROWS=2000000
# SAND_MAX_OFFLINE_ASK_ROWS=10000
# SAND_MAX_DATA_DIR_BYTES=10737418240
# SAND_QUERY_TIMEOUT_SECONDS=30.0
# SAND_CHART_SAMPLE_ROWS=5000

# Security (Docker / remote publish)
# SAND_API_TOKEN=
# SAND_ALLOW_INSECURE_BIND=false
